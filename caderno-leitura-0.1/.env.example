# Configurações do Google OAuth 2.0 (Leitorum)
# Obtenha estas credenciais no Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Crie um "ID do cliente OAuth" do tipo "Aplicativo da Web"
# Origens JavaScript autorizadas: http://localhost:8000
# URIs de redirecionamento autorizados: http://localhost:8000/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Políticas de Segurança e Autenticação
REQUIRE_AUTH=true
ALLOW_REGISTRATION=true

# Armazenamento no HD (feature 090-A). Deixe em branco para manter tudo em backend/data/.
# A pasta precisa ter o marcador .leitorum-storage.json, criado pela migração
# (scripts/migrate_storage_to_hd.py). Sem o HD certo, o Leitorum não inicia e não cria nada.
# CADERNO_DATABASE_PATH, CADERNO_COVERS_DIR e CADERNO_AVATARS_DIR, se definidos, vencem esta raiz.
LEITORUM_STORAGE_ROOT=
# Segunda cópia dos backups, obrigatoriamente fora do HD (por exemplo, no disco do sistema).
LEITORUM_SECONDARY_BACKUP_DIR=
# Backup automático do banco (camada de proteção 2): a cada N horas (0 desliga), guardando os K mais recentes,
# na pasta de backups e na segunda cópia.
LEITORUM_AUTO_BACKUP_HOURS=24
LEITORUM_AUTO_BACKUP_KEEP=14
# Cofre de imagens (feature 090-B). Prefira a chave protegida pelo Windows: py -3.13 instalar.py --media-key
# (fica em %LOCALAPPDATA%\Leitorum\media-master.key). Só use a variável abaixo onde não houver DPAPI, e nunca
# com este .env dentro do HD. Base64 de 32 bytes.
# LEITORUM_MEDIA_MASTER_KEY=
# LEITORUM_MEDIA_KEY_FILE=
