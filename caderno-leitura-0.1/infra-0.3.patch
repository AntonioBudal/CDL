+    script = '''
+import os, sys
+from pathlib import Path
+from app.services.maintenance import restore_archive
+original = Path.replace
+def terminate(path, target):
+    if path.parent.name == 'new' and path.name == 'caderno.db': os._exit(9)
+    return original(path, target)
+Path.replace = terminate
+restore_archive(Path(sys.argv[1]))
+'''
