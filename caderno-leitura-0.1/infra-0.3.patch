@@ -0,0 +1,45 @@
+from contextlib import asynccontextmanager
+from datetime import UTC, datetime
+import logging
+
+import anyio
+
+from app.db.session import get_engine
+from app.services.archives import daily_backup, inspect_database, migration_scripts
+from app.services.storage import ensure_no_restore, runtime_lease
+
+logger = logging.getLogger(__name__)
+
+
+async def scheduled_backups():
+    last_day = None
+    while True:
+        today = datetime.now(UTC).date()
+        if last_day != today:
+            try:
+                path = await anyio.to_thread.run_sync(daily_backup)
+                logger.info("Backup automático disponível: %s", path)
+                last_day = today
+            except Exception:
+                logger.exception("Backup automático falhou; nova tentativa em cinco minutos.")
+        await anyio.sleep(300)
+
+
+@asynccontextmanager
+async def runtime_lifespan(_application):
+    with runtime_lease() as database:
+        ensure_no_restore(database)
+        info = inspect_database(database)
+        if info["schema_revision"] != migration_scripts().get_current_head():
+            raise RuntimeError("Migração pendente. Feche o servidor e execute manutencao.py atualizar.")
+        try:
+            async with anyio.create_task_group() as group:
+                group.start_soon(scheduled_backups)
+                try:
+                    yield
+                finally:
+                    group.cancel_scope.cancel()
+        finally:
+            if get_engine.cache_info().currsize:
+                get_engine().dispose()
+                get_engine.cache_clear()
