+from sqlalchemy.orm import Session
+
+from app.core.config import BACKEND_DIR
+from app.db.session import create_sqlite_engine, get_engine
+from app.main import create_app
+from app.models import Book, Chapter
+from app.services import archives, maintenance
+from app.services.archives import create_archive, daily_backup, inspect_database, unpack_archive
+from app.services.maintenance import recover_restore, restore_archive
+from app.services.storage import backup_directory, covers_path, data_guard, restore_marker, runtime_lease
+
+COVER = 'a' * 32 + '.png'
+
+
+def migrate(path, revision='head'):
+    config = Config(str(BACKEND_DIR / 'alembic.ini'))
+    config.attributes['database_path'] = path
+    command.upgrade(config, revision)
+    return config
+
+
+@pytest.fixture
+def acervo(tmp_path, monkeypatch):
