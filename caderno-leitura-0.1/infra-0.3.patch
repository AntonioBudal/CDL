+++ b/manutencao.py
@@ -0,0 +1,56 @@
+"""Execute com backend/.venv/Scripts/python.exe no Windows."""
+import argparse
+import json
+from pathlib import Path
+import sys
+from tempfile import TemporaryDirectory
+
+ROOT = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / "backend"))
+
+
+def main() -> int:
+    from alembic import command
+    from alembic.config import Config
+    from app.services.archives import archive_name, create_archive, unpack_archive
+    from app.services.maintenance import recover_restore, restore_archive
+    from app.services.storage import backup_directory, ensure_no_restore, runtime_lease
+
+    parser = argparse.ArgumentParser(description="Manutenção do Caderno de Leitura")
+    parser.add_argument("acao", choices=("atualizar", "backup", "verificar", "restaurar", "recuperar"))
+    parser.add_argument("arquivo", nargs="?", type=Path)
+    parser.add_argument("--confirmar", action="store_true", help="Aplicar a restauração/recuperação no acervo configurado.")
+    args = parser.parse_args()
+    if args.acao in {"verificar", "restaurar"} and args.arquivo is None:
+        parser.error("Informe o caminho do backup ZIP.")
+    if args.acao == "recuperar" and not args.confirmar:
+        parser.error("Use --confirmar para recuperar o acervo anterior à restauração interrompida.")
+    try:
+        if args.acao == "atualizar":
+            command.upgrade(Config(str(ROOT / "backend" / "alembic.ini")), "head")
+            print("Banco atualizado.")
+        elif args.acao == "backup":
+            with runtime_lease() as database:
+                ensure_no_restore(database)
+                destination = args.arquivo.resolve() if args.arquivo else backup_directory(database) / archive_name()
+                create_archive(destination, database=database)
+                print(f"Backup criado: {destination}")
+        elif args.acao == "recuperar":
+            print(f"Acervo anterior recuperado. Pasta da operação: {recover_restore()}")
+        elif args.acao == "restaurar" and args.confirmar:
+            info, previous = restore_archive(args.arquivo.resolve())
+            print(json.dumps(info, ensure_ascii=False, indent=2))
+            print(f"Restauração concluída. Acervo anterior preservado em: {previous}")
+        else:
+            with TemporaryDirectory(prefix="caderno-verificar-") as work:
+                info = unpack_archive(args.arquivo.resolve(), Path(work) / "check")
+            print(json.dumps({key: info[key] for key in ("created_at", "schema_revision", "counts")}, ensure_ascii=False, indent=2))
+            print("Backup válido. Para substituir o acervo, use restaurar com --confirmar e o servidor fechado.")
+        return 0
+    except Exception as error:
+        print(f"Manutenção interrompida: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())