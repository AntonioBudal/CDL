+    monkeypatch.setenv('CADERNO_DATABASE_PATH', str(database))
+    monkeypatch.delenv('CADERNO_BACKUP_DIR', raising=False)
+    monkeypatch.delenv('CADERNO_BACKUP_KEEP', raising=False)
+    get_engine.cache_clear()
+    migrate(database)
+    with closing(sqlite3.connect(database, autocommit=True)) as db:
+        db.execute('PRAGMA foreign_keys=ON')
+        db.execute('INSERT INTO books (id,title,author,cover_path) VALUES (1,?,?,?)', ('Livro 📚', 'Autora', COVER))
+        db.execute("INSERT INTO chapters (id,book_id,name,position) VALUES (2,1,'Capítulo',0)")
+        db.execute("INSERT INTO studies (id,chapter_id,title,summary,notes) VALUES (3,2,'Estudo','Resumo','Nota original')")
+    covers_path().mkdir()
+    (covers_path() / COVER).write_bytes(b'\x89PNG\r\n\x1a\n' + b'imagem de teste' * 100)
+    yield database
+    if get_engine.cache_info().currsize:
