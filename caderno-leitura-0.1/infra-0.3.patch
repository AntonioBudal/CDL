diff --git a/backend/app/services/archives.py b/backend/app/services/archives.py
new file mode 100644
--- /dev/null
+++ b/backend/app/services/archives.py
@@ -0,0 +1,230 @@
+"""Backup portátil do banco e das capas; sem extração de caminhos arbitrários."""
+from contextlib import closing
+from datetime import UTC, datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import stat
+from tempfile import TemporaryDirectory
+from uuid import uuid4
+from zipfile import BadZipFile, ZIP_DEFLATED, ZIP_STORED, ZipFile
+
+from alembic.config import Config
+from alembic.script import ScriptDirectory
+
+from app import __version__
+from app.core.config import BACKEND_DIR, get_database_path
+from app.services.backups import create_database_backup
+from app.services.storage import backup_directory, covers_path, data_guard, private_path
+
+TABLES = ("books", "chapters", "studies")
+COVER_NAME = re.compile(r"[0-9a-f]{32}\.(?:png|jpg|jpeg|webp)")
+MAX_BYTES = 4 * 1024**3
+MAX_FILES = 20_002
+MAX_MANIFEST = 8 * 1024**2
+CHUNK = 1024**2
+
+
+def migration_scripts() -> ScriptDirectory:
+    return ScriptDirectory.from_config(Config(str(BACKEND_DIR / "alembic.ini")))
+
+
+def inspect_database(path: Path) -> dict:
+    if not path.is_file() or path.stat().st_size == 0:
+        raise ValueError("Banco ausente ou vazio.")
+    with closing(sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, autocommit=True)) as db:
+        db.execute("PRAGMA trusted_schema=OFF")
+        if db.execute("PRAGMA integrity_check").fetchall() != [("ok",)]:
+            raise ValueError("O banco falhou na verificação de integridade.")
+        if db.execute("PRAGMA foreign_key_check").fetchone() is not None:
+            raise ValueError("O banco contém relacionamentos inválidos.")
+        revisions = db.execute("SELECT version_num FROM alembic_version").fetchall()
+        known = {item.revision for item in migration_scripts().walk_revisions()}
+        if len(revisions) != 1 or revisions[0][0] not in known:
+            raise ValueError("A versão do banco é desconhecida ou exige outra versão do aplicativo.")
+        revision = revisions[0][0]
+        required = {
+            "books": {"id", "title", "author"},
+            "chapters": {"id", "book_id", "name", "position"},
+            "studies": {"id", "chapter_id", "title", "location", "source_response", "summary",
+                        "explanation", "concepts", "references", "notes", "created_at", "updated_at"},
+        }
+        for table, columns in required.items():
+            found = {row[1] for row in db.execute(f'PRAGMA table_info("{table}")')}
+            if revision != "0001_initial":
+                columns = columns | {"version"} | ({"cover_path"} if table == "books" else set())
+            if not columns <= found:
+                raise ValueError(f"Estrutura incompleta na tabela {table}.")
+            if "version" in found and db.execute(
+                f'SELECT 1 FROM "{table}" WHERE typeof(version) != \'integer\' OR version < 1 LIMIT 1'
+            ).fetchone():
+                raise ValueError("O banco contém uma versão de registro inválida.")
+        for table, parent, column in (("chapters", "books", "book_id"), ("studies", "chapters", "chapter_id")):
+            foreign_keys = {(row[2], row[3], row[4]) for row in db.execute(f'PRAGMA foreign_key_list("{table}")')}
+            if (parent, column, "id") not in foreign_keys:
+                raise ValueError(f"A chave estrangeira de {table} está ausente.")
+        covers = [] if revision == "0001_initial" else [row[0] for row in db.execute(
+            "SELECT cover_path FROM books WHERE cover_path IS NOT NULL"
+        )]
+        if any(not isinstance(name, str) or not COVER_NAME.fullmatch(name) for name in covers):
+            raise ValueError("O banco contém uma referência de capa inválida.")
+        return {
+            "schema_revision": revision,
+            "counts": {table: db.execute(f'SELECT count(*) FROM "{table}"').fetchone()[0] for table in TABLES},
+            "covers": sorted(set(covers)),
+        }
+
+
+def archive_name(kind: str = "manual", database: Path | None = None) -> str:
+    database = private_path(database or get_database_path())
+    identity = hashlib.sha256(os.path.normcase(str(database)).encode()).hexdigest()[:12]
+    stamp = datetime.now(UTC).strftime("%Y%m%d-%H%M%S-%fZ")
+    return f"caderno-{kind}-{identity}-{stamp}-{uuid4().hex[:8]}.zip"
+
+
+def _linked(path: Path) -> bool:
+    return path.is_symlink() or path.is_junction()
+
+
+def create_archive(destination: Path, *, database: Path | None = None, kind: str = "manual") -> dict:
+    database = private_path(database or get_database_path())
+    destination = private_path(destination)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    if destination.exists():
+        raise FileExistsError("O arquivo de destino já existe.")
+    with data_guard(), TemporaryDirectory(prefix=".caderno-backup-", dir=destination.parent) as work:
+        snapshot = Path(work) / "caderno.db"
+        create_database_backup(snapshot, source=database)
+        info = inspect_database(snapshot)
+        folder = covers_path(database)
+        if _linked(folder):
+            raise ValueError("A pasta de capas não pode ser um link ou junção.")
+        covers = sorted(folder.iterdir()) if folder.exists() else []
+        for cover in covers:
+            if _linked(cover) or not cover.is_file() or not COVER_NAME.fullmatch(cover.name):
+                raise ValueError(f"Arquivo não permitido na pasta de capas: {cover.name}")
+        if not set(info["covers"]) <= {item.name for item in covers}:
+            raise ValueError("Há capas referenciadas no banco que não foram encontradas no disco.")
+        sources = [("caderno.db", snapshot)] + [(f"covers/{cover.name}", cover) for cover in covers]
+        if len(sources) + 1 > MAX_FILES or sum(path.stat().st_size for _, path in sources) > MAX_BYTES:
+            raise ValueError("O acervo excede os limites configurados para o pacote de backup.")
+        manifest = {"format": 1, "application_version": __version__, "kind": kind,
+                    "created_at": datetime.now(UTC).isoformat(), **info, "files": {}}
+        temporary = Path(work) / "backup.zip"
+        with ZipFile(temporary, "w", compression=ZIP_DEFLATED, compresslevel=6) as archive:
+            for name, path in sources:
+                digest, size = hashlib.sha256(), 0
+                with path.open("rb") as original, archive.open(name, "w", force_zip64=True) as output:
+                    while chunk := original.read(CHUNK):
+                        size += len(chunk)
+                        digest.update(chunk)
+                        output.write(chunk)
+                manifest["files"][name] = {"size": size, "sha256": digest.hexdigest()}
+            archive.writestr("manifest.json", json.dumps(manifest, ensure_ascii=False, indent=2).encode("utf-8"))
+        with temporary.open("rb") as handle:
+            os.fsync(handle.fileno())
+        temporary.replace(destination)
+        return manifest
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("O manifesto contém campos duplicados.")
+        result[key] = value
+    return result
+
+
+def unpack_archive(archive_path: Path, destination: Path) -> dict:
+    """destination deve ser uma pasta temporária nova, nunca a pasta do acervo."""
+    destination.mkdir(parents=True, exist_ok=False)
+    with ZipFile(archive_path) as archive:
+        entries = archive.infolist()
+        names = [entry.filename for entry in entries]
+        if len(entries) > MAX_FILES or len(set(names)) != len(names):
+            raise ValueError("Quantidade excessiva ou entradas duplicadas no ZIP.")
+        if "manifest.json" not in names or "caderno.db" not in names:
+            raise ValueError("O pacote precisa conter manifest.json e caderno.db.")
+        if sum(entry.file_size for entry in entries) > MAX_BYTES + MAX_MANIFEST:
+            raise ValueError("O tamanho descompactado ultrapassa o limite permitido.")
+        for entry in entries:
+            valid = entry.filename in {"manifest.json", "caderno.db"} or (
+                entry.filename.startswith("covers/") and COVER_NAME.fullmatch(entry.filename[7:])
+            )
+            mode = stat.S_IFMT(entry.external_attr >> 16)
+            if not valid or mode not in {0, stat.S_IFREG} or entry.flag_bits & 1:
+                raise ValueError("O ZIP contém um caminho, link ou tipo de arquivo não permitido.")
+            if entry.compress_type not in {ZIP_STORED, ZIP_DEFLATED}:
+                raise ValueError("O método de compressão do ZIP não é suportado.")
+        if archive.getinfo("manifest.json").file_size > MAX_MANIFEST:
+            raise ValueError("Manifesto excessivamente grande.")
+        manifest = json.loads(archive.read("manifest.json"), object_pairs_hook=_unique_object)
+        if not isinstance(manifest, dict) or type(manifest.get("format")) is not int or manifest["format"] != 1:
+            raise ValueError("Formato de backup incompatível.")
+        if not isinstance(manifest.get("application_version"), str) or not isinstance(manifest.get("created_at"), str):
+            raise ValueError("O manifesto não informa versão e data válidas.")
+        if datetime.fromisoformat(manifest["created_at"]).tzinfo is None:
+            raise ValueError("A data do backup deve incluir o fuso horário.")
+        counts = manifest.get("counts")
+        if not isinstance(counts, dict) or set(counts) != set(TABLES) or any(type(n) is not int or n < 0 for n in counts.values()):
+            raise ValueError("O manifesto contém contagens inválidas.")
+        files = manifest.get("files")
+        if not isinstance(files, dict) or set(files) != set(names) - {"manifest.json"}:
+            raise ValueError("A lista de arquivos diverge do manifesto.")
+        for name, expected in files.items():
+            if not isinstance(expected, dict) or type(expected.get("size")) is not int or expected["size"] < 0:
+                raise ValueError("Tamanho inválido no manifesto.")
+            if not isinstance(expected.get("sha256"), str) or not re.fullmatch(r"[0-9a-f]{64}", expected["sha256"]):
+                raise ValueError("Hash inválido no manifesto.")
+            if archive.getinfo(name).file_size != expected["size"]:
+                raise ValueError("O tamanho de um arquivo diverge do manifesto.")
+            target = destination / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            digest, size = hashlib.sha256(), 0
+            with archive.open(name) as original, target.open("xb") as output:
+                while chunk := original.read(CHUNK):
+                    size += len(chunk)
+                    if size > expected["size"]:
+                        raise ValueError("O conteúdo excede o tamanho declarado.")
+                    digest.update(chunk)
+                    output.write(chunk)
+            if size != expected["size"] or digest.hexdigest() != expected["sha256"]:
+                raise ValueError(f"O arquivo {name} está incompleto ou corrompido.")
+        info = inspect_database(destination / "caderno.db")
+        if any(manifest.get(key) != value for key, value in info.items()):
+            raise ValueError("Os dados do banco divergem do manifesto.")
+        if any(f"covers/{name}" not in files for name in info["covers"]):
+            raise ValueError("O pacote não contém todas as capas referenciadas pelo banco.")
+        (destination / "covers").mkdir(exist_ok=True)
+        return manifest
+
+
+def daily_backup() -> Path:
+    database = private_path(get_database_path())
+    directory = backup_directory(database)
+    keep = int(os.environ.get("CADERNO_BACKUP_KEEP", "7"))
+    if not 1 <= keep <= 365:
+        raise ValueError("CADERNO_BACKUP_KEEP deve estar entre 1 e 365.")
+    example = archive_name("daily", database)
+    prefix = example.rsplit("-", 4)[0]
+    today = datetime.now(UTC).strftime("%Y%m%d")
+    existing = sorted(directory.glob(f"{prefix}-{today}-*.zip"), reverse=True)
+    for path in existing:
+        try:
+            with TemporaryDirectory(prefix="caderno-verificar-") as work:
+                unpack_archive(path, Path(work) / "check")
+            return path
+        except (OSError, ValueError, sqlite3.Error, BadZipFile):
+            continue
+    target = directory / example
+    create_archive(target, database=database, kind="daily")
+    # Só arquivos automáticos deste banco; exports e cópias de migração são preservados.
+    owned = re.compile(re.escape(prefix) + r"-\d{8}-\d{6}-\d{6}Z-[0-9a-f]{8}\.zip")
+    previous = sorted((path for path in directory.glob(f"{prefix}-*.zip") if owned.fullmatch(path.name)), reverse=True)
+    for path in previous[keep:]:
+        path.unlink()
+    return target
