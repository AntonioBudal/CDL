+++ b/backend/app/services/maintenance.py
@@ -0,0 +1,136 @@
+from contextlib import contextmanager
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+from uuid import uuid4
+
+from alembic import command
+from alembic.config import Config
+
+from app.core.config import BACKEND_DIR, get_database_path
+from app.services.archives import archive_name, create_archive, inspect_database, migration_scripts, unpack_archive
+from app.services.storage import backup_directory, ensure_no_restore, private_path, restore_marker, runtime_lease
+
+
+@contextmanager
+def migration_guard(database: Path):
+    with runtime_lease(database):
+        ensure_no_restore(database)
+        if database.exists():
+            info = inspect_database(database)
+            if info["schema_revision"] != migration_scripts().get_current_head():
+                target = backup_directory(database) / archive_name("before-migration", database)
+                create_archive(target, database=database, kind="before-migration")
+                print(f"Backup anterior à migração: {target}", flush=True)
+        yield
+
+
+def _components(database: Path) -> list[str]:
+    return [database.name, database.name + "-wal", database.name + "-shm", database.name + "-journal", "covers"]
+
+
+def _remove(path: Path) -> None:
+    if path.is_symlink() or path.is_junction():
+        raise ValueError("A restauração não permite links ou junções no destino.")
+    if path.is_dir():
+        shutil.rmtree(path)
+    elif path.exists():
+        path.unlink()
+
+
+def _write_marker(database: Path, state: dict) -> None:
+    marker = restore_marker(database)
+    temporary = marker.with_suffix(".tmp")
+    with temporary.open("w", encoding="utf-8") as file:
+        json.dump(state, file)
+        file.flush()
+        os.fsync(file.fileno())
+    temporary.replace(marker)
+
+
+def _recover(database: Path) -> Path:
+    marker = restore_marker(database)
+    state = json.loads(marker.read_text(encoding="utf-8"))
+    if (not isinstance(state, dict) or not isinstance(state.get("job"), str)
+            or not re.fullmatch(r"\.caderno-restore-[0-9a-f]{32}", state["job"])
+            or not isinstance(state.get("present"), dict)
+            or set(state["present"]) != set(_components(database))
+            or any(type(value) is not bool for value in state["present"].values())):
+        raise ValueError("O registro de recuperação é inválido. Preserve os arquivos e confira a pasta de restauração.")
+    job = database.parent / state["job"]
+    if job.is_symlink() or job.is_junction() or not (job / "previous").is_dir():
+        raise ValueError("A pasta com o acervo anterior não foi encontrada.")
+    for name, was_present in state["present"].items():
+        saved, current = job / "previous" / name, database.parent / name
+        if saved.exists():
+            _remove(current)
+            saved.replace(current)
+        elif not was_present:
+            _remove(current)
+    marker.unlink()
+    return job
+
+
+def recover_restore() -> Path:
+    with runtime_lease() as database:
+        if not restore_marker(database).exists():
+            raise ValueError("Não há restauração interrompida para recuperar.")
+        return _recover(database)
+
+
+def restore_archive(archive: Path) -> tuple[dict, Path]:
+    with runtime_lease() as database:
+        ensure_no_restore(database)
+        # Evita colisões dos nomes reservados da pasta persistente.
+        if database.name in {"covers", "caderno.db-wal", "caderno.db-shm", "caderno.db-journal"}:
+            raise ValueError("O nome configurado para o banco conflita com um nome reservado.")
+        for name in _components(database):
+            current = database.parent / name
+            if current.is_symlink() or current.is_junction():
+                raise ValueError("O destino contém um link ou junção.")
+        job = database.parent / f".caderno-restore-{uuid4().hex}"
+        job.mkdir()
+        try:
+            manifest = unpack_archive(archive, job / "new")
+            staged = job / "new" / "caderno.db"
+            # Backups antigos conhecidos são migrados apenas na cópia temporária.
+            config = Config(str(BACKEND_DIR / "alembic.ini"))
+            config.attributes.update(database_path=staged, maintenance_lock=True)
+            command.upgrade(config, "head")
+            current_info = inspect_database(staged)
+            if current_info["counts"] != manifest["counts"]:
+                raise ValueError("A migração alterou a contagem de registros do backup.")
+            for path in (job / "new").rglob("*"):
+                if path.is_file():
+                    with path.open("rb") as file:
+                        os.fsync(file.fileno())
+            (job / "previous").mkdir()
+            state = {"job": job.name, "present": {
+                name: (database.parent / name).exists() for name in _components(database)
+            }}
+            _write_marker(database, state)
+        except BaseException:
+            if restore_marker(database).exists():
+                _recover(database)
+            else:
+                shutil.rmtree(job)
+            raise
+
+        try:
+            for name, exists in state["present"].items():
+                if exists:
+                    (database.parent / name).replace(job / "previous" / name)
+            (job / "new" / "covers").replace(database.parent / "covers")
+            staged.replace(database)
+            restore_marker(database).unlink()
+        except BaseException:
+            # Se o processo for encerrado à força, o marcador permite repetir
+            # esta recuperação no próximo comando, antes de abrir o servidor.
+            try:
+                _recover(database)
+            except Exception as error:
+                raise RuntimeError("A restauração foi interrompida. Os originais foram preservados; execute manutencao.py recuperar --confirmar.") from error
+            raise
+        return current_info, job / "previous"
