+@pytest.mark.parametrize('damage', ['hash', 'path', 'missing', 'future', 'counts', 'invalid-db'])
+def test_invalid_packages_never_modify_current_acervo(acervo, tmp_path, damage):
+    source = tmp_path / 'good.zip'; create_archive(source)
+    current = rows(acervo)
+
+    def corrupt(contents):
+        manifest = json.loads(contents['manifest.json'])
+        if damage == 'hash': manifest['files']['caderno.db']['sha256'] = '0' * 64
+        elif damage == 'path': contents['../escape.txt'] = b'bad'
+        elif damage == 'missing': del contents[f'covers/{COVER}']
+        elif damage == 'future': manifest['format'] = 999
+        elif damage == 'counts': manifest['counts']['studies'] = 999
+        elif damage == 'invalid-db':
+            contents['caderno.db'] = b'not a database'
+            manifest['files']['caderno.db'] = {'size': len(contents['caderno.db']), 'sha256': hashlib.sha256(contents['caderno.db']).hexdigest()}
+        contents['manifest.json'] = json.dumps(manifest).encode()
+
+    damaged = tmp_path / 'damaged.zip'; rewrite_zip(source, damaged, corrupt)
+    with pytest.raises((ValueError, sqlite3.Error, BadZipFile)):
+        restore_archive(damaged)
+    assert rows(acervo) == current
+    assert not restore_marker(acervo).exists()
+    assert not (tmp_path / 'escape.txt').exists()
+
