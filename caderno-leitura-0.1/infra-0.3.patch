@@ -0,0 +1,83 @@
+"""Coordenação local do acervo. Um processo de servidor por banco."""
+from contextlib import contextmanager
+import os
+from pathlib import Path
+from threading import Lock
+
+from app.core.config import BACKEND_DIR, get_database_path
+
+_data_lock = Lock()
+
+
+def private_path(path: Path) -> Path:
+    if not path.is_absolute():
+        raise ValueError("Os caminhos de armazenamento devem ser absolutos.")
+    path = path.resolve()
+    frontend = (BACKEND_DIR.parent / "frontend").resolve()
+    if path == frontend or path.is_relative_to(frontend):
+        raise ValueError("Guarde os dados e backups fora da pasta frontend.")
+    return path
+
+
+def covers_path(database: Path | None = None) -> Path:
+    return private_path(database or get_database_path()).parent / "covers"
+
+
+def backup_directory(database: Path | None = None) -> Path:
+    database = private_path(database or get_database_path())
+    configured = os.environ.get("CADERNO_BACKUP_DIR")
+    result = private_path(Path(configured).expanduser()) if configured else database.parent / "backups"
+    covers = covers_path(database)
+    if result == covers or result.is_relative_to(covers):
+        raise ValueError("A pasta de backups deve ficar fora da pasta de capas.")
+    return result
+
+
+def restore_marker(database: Path) -> Path:
+    return database.parent / f".{database.name}.restore.json"
+
+
+def ensure_no_restore(database: Path) -> None:
+    if restore_marker(database).exists():
+        raise RuntimeError("Há uma restauração interrompida. Execute manutencao.py recuperar --confirmar.")
+
+
+@contextmanager
+def data_guard():
+    # Lock simples: o FastAPI pode entrar e sair da dependência em threads distintas.
+    if not _data_lock.acquire(timeout=30):
+        raise TimeoutError("O acervo está ocupado. Aguarde o backup e tente novamente.")
+    try:
+        yield
+    finally:
+        _data_lock.release()
+
+
+@contextmanager
+def runtime_lease(database: Path | None = None):
+    database = private_path(database or get_database_path())
+    database.parent.mkdir(parents=True, exist_ok=True)
+    # Nunca apague este arquivo: o bloqueio pertence ao descritor aberto no SO.
+    with (database.parent / f".{database.name}.lock").open("a+b") as handle:
+        handle.seek(0, os.SEEK_END)
+        if handle.tell() == 0:
+            handle.write(b"0")
+            handle.flush()
+        handle.seek(0)
+        try:
+            if os.name == "nt":
+                import msvcrt
+                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as error:
+            raise RuntimeError("O acervo está em uso. Feche o servidor e outras manutenções antes de continuar.") from error
+        try:
+            yield database
+        finally:
+            handle.seek(0)
+            if os.name == "nt":
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
