new file mode 100644
--- /dev/null
+++ b/frontend/tests/conflicts.test.mjs
@@ -0,0 +1,67 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { useStudyEdit } from '../src/composables/useStudyEdit.ts'
+import { ApiError } from '../src/services/api.ts'
+
+const initial = { id: 1, version: 1, chapter_id: 2, title: 'Estudo', location: '',
+  summary: 'Resumo', explanation: '', concepts: '', references: '', notes: 'Original',
+  source_response: 'Fonte', created_at: '', updated_at: '' }
+
+test('conflito conserva o rascunho e combina somente após revisão explícita', async () => {
+  let saved = { ...initial, version: 2, notes: 'Celular' }
+  const requests = []
+  const editor = useStudyEdit({
+    getStudy: async () => ({ ...saved }),
+    updateStudy: async (_id, patch) => {
+      requests.push(patch)
+      if (patch.version !== saved.version) throw new ApiError('Conflito', 409)
+      saved = { ...saved, ...patch, version: saved.version + 1 }
+      return saved
+    },
+  })
+  editor.load(initial)
+  editor.state.sections.summary = 'Resumo do PC'
+  assert.equal(await editor.save(), null)
+  assert.equal(editor.state.conflict, true)
+  assert.equal(editor.dirty.value, true)
+  assert.equal(editor.state.sections.summary, 'Resumo do PC')
+  assert.equal(editor.canSave.value, false)
+  await editor.reviewConflict()
+  assert.equal(editor.state.notes, 'Original')
+  editor.acceptLatestBase()
+  assert.equal(editor.state.notes, 'Celular')
+  assert.equal(editor.state.sections.summary, 'Resumo do PC')
+  assert.equal(requests.length, 1)
+  await editor.save()
+  assert.deepEqual(requests[1], { summary: 'Resumo do PC', version: 2 })
+  assert.equal(editor.state.saving, false)
+  assert.equal(editor.dirty.value, false)
+})
+
+test('nova alteração depois da revisão causa novo conflito sem apagar o texto', async () => {
+  let version = 2
+  const editor = useStudyEdit({
+    getStudy: async () => ({ ...initial, version, notes: 'Celular' }),
+    updateStudy: async () => { throw new ApiError('Conflito', 409) },
+  })
+  editor.load(initial)
+  editor.state.notes = 'Meu texto'
+  await editor.save(); await editor.reviewConflict(); editor.acceptLatestBase()
+  version++
+  await editor.save()
+  assert.equal(editor.state.conflict, true)
+  assert.equal(editor.state.notes, 'Meu texto')
+})
+
+test('falha de consulta mantém rascunho e bloqueio de conflito', async () => {
+  const editor = useStudyEdit({
+    getStudy: async () => { throw new ApiError('Sem rede', 0) },
+    updateStudy: async () => { throw new ApiError('Conflito', 409) },
+  })
+  editor.load(initial); editor.state.notes = 'Preservar'
+  await editor.save(); await editor.reviewConflict()
+  assert.equal(editor.state.notes, 'Preservar')
+  assert.equal(editor.state.conflict, true)
+  assert.equal(editor.state.latest, null)
+  assert.equal(editor.state.reviewing, false)
+})
